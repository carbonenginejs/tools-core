# Copy to `.env` in this directory and fill in. `.env` is gitignored and is not
# in package.json "files", so it is never committed and never published.
#
# Sign in with: npm run server, then npm run login:eve
# (that is EVE Online SSO - npm is just the task runner)
#
# EVE SSO, used ONLY while the SKINR endpoints are insider-gated. When they go
# public, delete these three lines and src/auth - nothing else depends on them.

# From your application at https://developers.eveonline.com/applications
# NOT a secret: PKCE puts it in the authorize url in plain sight. It lives here
# because it differs per deployment, not because it is confidential.
CJS_ESI_CLIENT_ID=

# Must match the application's registered callback EXACTLY - scheme, host, port
# and path. The service defaults to port 5510 so this can be registered at all.
#   local:  http://localhost:5510/v1/auth/esi/callback
#   hosted: https://caldariprimeponyclub.com/api/auth/esi/callback
CJS_ESI_CALLBACK=http://localhost:5510/v1/auth/esi/callback

# Space separated. EMPTY is correct for everything tools-core does today.
#
# The public SKINR endpoints take "any valid token" - they are gated at the
# application level, not by scope, so the login exists to prove which
# application is calling rather than to grant access to data. That covers SKINr
# attributes (/cosmetics/skinr/{id}) and the public Paragon Hub listing
# (/paragon-hub/skinr). Requesting no scopes means the authorize url omits the
# parameter entirely.
#
#   esi.cosmetic.char:read
#
# is the one scope in this area, and it covers the TARGETED listing endpoints -
# /paragon-hub/skinr/{characters,corporations,alliances}/{id}. Those answer
# "what is visible to this character/corp/alliance", so the response depends on
# whose token asked.
#
# Add it only if tools-core genuinely needs to browse listings targeted at the
# OPERATOR. It must never be used to answer for anybody else: a response cached
# without the asking identity in its key would show one user another's visible
# listings, which is a caching bug that survives review because the auth looks
# correct.
CJS_ESI_SCOPES=

# There is deliberately no client secret. This is a public OAuth client: the
# proof is the PKCE code verifier, and CjsToolEveSso has no parameter for a
# secret, so one cannot be configured even by accident.
